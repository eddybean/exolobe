{
  "name": "online-meeting-recorder",
  "version": "0.1.0",
  "description": "Mac 向け Web 会議レコーダー（録音・文字起こし・話者識別・要約をすべてローカルで実行）",
  "main": "./out/main/index.js",
  "author": "eddybean",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "setup": "bash scripts/setup.sh",
    "postinstall": "bash scripts/patch-dev-electron.sh || true",
    "build:whisper": "bash scripts/build-whisper.sh",
    "package": "npm run build && npm run build:whisper && electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "audiotee": "^0.0.7",
    "node-llama-cpp": "^3.20.0",
    "sherpa-onnx": "^1.13.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-vite": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "electron-builder": "^25.1.8"
  }
}
