{
  "name": "duoscribe",
  "version": "0.1.1",
  "description": "Web 会議の録音・文字起こし・話者識別・要約を Mac の中だけで実行するデスクトップアプリ",
  "main": "./out/main/index.js",
  "author": "eddybean",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "predev": "node scripts/check-node-modules.mjs",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "pretypecheck": "node scripts/check-node-modules.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "node scripts/check-node-modules.mjs",
    "test": "vitest run",
    "pretest:watch": "node scripts/check-node-modules.mjs",
    "test:watch": "vitest",
    "lint": "oxlint",
    "setup": "bash scripts/setup.sh",
    "postinstall": "install-electron && (bash scripts/patch-dev-electron.sh || true)",
    "build:icon": "node scripts/build-icon.mjs",
    "build:whisper": "bash scripts/build-whisper.sh",
    "build:micwatch": "bash scripts/build-micwatch.sh",
    "package": "npm run build && npm run build:whisper && npm run build:micwatch && electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "audiotee": "^0.0.7",
    "node-llama-cpp": "^3.20.0",
    "sherpa-onnx-node": "^1.13.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "oxlint": "^1.82.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
