# 依存の導入を、乗っ取られた版や改ざんされた取得元から守るための設定。
#
# 公開から 7 日経っていない版は解決の候補にしない。乗っ取られたアカウントから出た版の
# 多くは数日で見つかって取り下げられるため、出たばかりの版を避けるだけで大半を外せる。
# 急ぎで新しい版が要るとき（脆弱性の修正など）は、そのパッケージを確かめたうえで
# `npm install <pkg>@<版> --min-release-age=0` のように一度だけ外す。
min-release-age=7
# git 参照の依存はレジストリの署名・完全性の検証を通らず、取得時に prepare スクリプトも走る。
# 今の依存には無いので、入ってこないように拒む。
allow-git=none
